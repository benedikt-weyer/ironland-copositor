#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

export IRONLAND_VM_PROJECT_DIR="$PWD"

out="$(mktemp -d)/vm"
nix build --impure .#nixosConfigurations.compositor-vm.config.system.build.vm -o "$out"

runner=("$out"/bin/run-*-vm)
if [ ! -e "${runner[0]}" ]; then
  echo "error: no run-*-vm script found in $out/bin" >&2
  exit 1
fi

echo "Booting the VM. The compositor autostarts on login as 'dev'."
echo

# The guest's virtio-gpu-gl display needs a working GL context on the *host*
# to composite into the QEMU window. If the host's Mesa can't find a hardware
# DRI driver for your GPU (as seen here), that context creation silently
# fails and the window comes up blank. Forcing software rendering sidesteps
# hardware driver detection entirely.
export LIBGL_ALWAYS_SOFTWARE=1

exec "${runner[0]}" "$@"
